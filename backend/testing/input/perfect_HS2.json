      "image_path": "images/HS_2/Cau_13a.jpg",
      "content": {
        "lines": [
          "int KiemtraSNT(int n) {",
          "    if (n < 2) return 0;",
          "    for (int i = 2; i * i <= n; i++)",
          "        if (n % i == 0) return 0;",
          "    return 1;",
          "}",
          "int TongSNT(int a[], int n) {",
          "    int S = 0;",
          "    for (int i = 0; i < n; i++)",
          "        if (KiemtraSNT(a[i])) S += a[i];",
          "    return S;",
          "}"
        ]
      },
